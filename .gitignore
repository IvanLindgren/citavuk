# OS
.DS_Store
Thumbs.db

# Claude / editor
.claude/
.idea/
*.iml

# Python
__pycache__/
*.pyc
.venv/
venv/
backend/analysis_cache.db

# Большие/генерируемые артефакты (слишком велики для git, легко пересобираются)
# srLex.tsv — исходник SrLex (~1.2 ГБ), скачивается download_srlex.py
srLex.tsv
# lexicon_srlex.db — словарь из SrLex (~900 МБ)
lexicon_srlex.db
# модели CLASSLA (~180 МБ), скачиваются автоматически
classla_models/

# Flutter build artifacts (продублировано к frontend/.gitignore)
frontend/build/
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/windows/flutter/ephemeral/
frontend/linux/flutter/ephemeral/
frontend/macos/Flutter/ephemeral/
frontend/ios/Flutter/ephemeral/
frontend/android/.gradle/
release

# Секреты: ключи DeepL, пароль БД, Google OAuth client secrets.
# Никогда не коммитить — файл существует только на машине разработчика и на
# сервере. Шаблон без значений лежит в .env.example.
.env
.env.local
.env.*.local
server/.env

# Keystores
upload-keystore*
generate_keystore.py
# Листы визуальной проверки спрайтов — генерируются tools/sprite_build
animations/qa/

# Сборки сайта и веб-зависимости
web/dist/
web/node_modules/
web/tsconfig.tsbuildinfo

# Скомпилированные утилиты — пересобираются из исходников
tools/course_build/*.exe

# Исходники спрайтов (16 МБ psd/png): в сборку идут готовые webp из assets
animations/source/
