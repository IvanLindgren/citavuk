            {"type": "multiple_choice", "difficulty": 2, "prompt": "Как сказать «большая кровать»?", "explanation": "Velik krevet. Слово krevet мужского рода, поэтому прилагательное тоже мужское.", "options": [{"id": "a", "text": "velik krevet", "correct": true}, {"id": "b", "text": "velika krevet", "misconceptionId": "misc_rod_krevet_zenski"}, {"id": "c", "text": "veliko krevet"}]},
