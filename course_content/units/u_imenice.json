            {"type": "letter_unscramble", "difficulty": 3, "prompt": "Соберите обращение к другу (prijatelj)", "explanation": "Prijatelju: мягкая основа требует окончания -u, а не -e.", "context": "Обращаемся к другу.", "lemma": "prijatelj", "targetFeats": "Case=Voc|Number=Sing", "answer": "prijatelju", "extraLetters": ["e"], "showLemma": true, "highlightStem": "prijatelj"},
