          "objectives": ["obj_nominativ_mnozina"],
          "intro": {
            "blocks": [
              {"kind": "paragraph", "text": "Именительный отвечает на *ko?* и *šta?* Это подлежащее и та форма, которая стоит в словаре. С неё начинается любой разбор: сначала находим именительный, потом смотрим, во что он превратился."},
              {"kind": "terms", "title": "МНОЖЕСТВЕННОЕ ЧИСЛО", "rows": [
                {"term": "мужской → -i", "gloss": "student → studenti", "note": "prozor → prozori"},
                {"term": "односложные → -ovi", "gloss": "grad → gradovi", "note": "sto → stolovi"},
                {"term": "после мягкой основы → -evi", "gloss": "muž → muževi", "note": "nož → noževi"},
                {"term": "женский → -e", "gloss": "žena → žene", "note": "knjiga → knjige"},
                {"term": "средний → -a", "gloss": "selo → sela", "note": "more → mora"}
              ]},
              {"kind": "paragraph", "text": "Перед окончанием *-i* заднеязычные меняются: *k → c*, *g → z*, *h → s*. Поэтому *radnik → radnici*, *geolog → geolozi*, *uspeh → uspesi*."},
              {"kind": "example", "serbian": "Studenti čitaju knjige.", "russian": "Студенты читают книги.", "highlight": "Studenti"},
              {"kind": "tip", "text": "Короткие мужские слова почти всегда берут *-ovi*: *grad → gradovi*, *voz → vozovi*, *most → mostovi*. Форма «gradi» звучит для серба так же странно, как «городы» для нас."}
            ]
          },
          "exercises": [
            {"type": "multiple_choice", "difficulty": 1, "prompt": "Как будет множественное число от «student»?", "explanation": "Studenti. Многосложные мужские слова берут окончание -i.", "options": [{"id": "a", "text": "studenti", "correct": true}, {"id": "b", "text": "studentovi"}, {"id": "c", "text": "studenta"}]},
            {"type": "multiple_choice", "difficulty": 2, "prompt": "Как будет множественное число от «grad»?", "explanation": "Gradovi. Односложные мужские слова получают расширение -ovi.", "options": [{"id": "a", "text": "gradovi", "correct": true}, {"id": "b", "text": "gradi", "misconceptionId": "misc_mnozina_bez_ov"}, {"id": "c", "text": "grada"}]},
            {"type": "matching", "difficulty": 2, "prompt": "Сопоставьте единственное число с множественным", "explanation": "Женские слова берут -e, средние -a, мужские -i или -ovi.", "leftLabel": "Один", "rightLabel": "Много", "pairs": [{"left": "žena", "right": "žene"}, {"left": "selo", "right": "sela"}, {"left": "prozor", "right": "prozori"}, {"left": "sto", "right": "stolovi"}], "distractorsRight": ["stoovi"]},
            {"type": "letter_unscramble", "difficulty": 3, "prompt": "Соберите множественное число слова «radnik»", "explanation": "Radnici: перед -i заднеязычное k переходит в c.", "context": "На стройке много рабочих.", "lemma": "radnik", "targetFeats": "Case=Nom|Number=Plur", "answer": "radnici", "extraLetters": [], "showLemma": true, "highlightStem": "radn"},
            {"type": "fill_blank", "difficulty": 3, "prompt": "Поставьте «knjiga» во множественное число", "explanation": "Knjige su na stolu. Женский род во множественном числе именительного берёт -e.", "segments": [{"kind": "blank", "id": "b1"}, {"kind": "text", "text": " su na stolu."}], "blanks": [{"id": "b1", "acceptedAnswers": ["Knjige", "knjige"], "caseSensitive": false}]},
            {"type": "multiple_choice", "difficulty": 3, "prompt": "Почему «geolog» даёт «geolozi», а не «geologi»?", "explanation": "Перед окончанием -i заднеязычные чередуются: k → c, g → z, h → s.", "options": [{"id": "a", "text": "Перед -i заднеязычное g переходит в z", "correct": true}, {"id": "b", "text": "Так проще произносить, правила тут нет"}, {"id": "c", "text": "Это исключение, которое нужно запомнить отдельно"}]}
