node_modules/
dist/
*.local
.vite/

# Готовые ассеты собираются из frontend/assets скриптом scripts/prepare-assets.py
# и в репозитории не нужны: это производные файлы, которые легко пересоздать.
# Каталог целиком не игнорируется: правило со звёздочкой позволяет вернуть
# отдельные файлы, которые скриптом не создаются.
public/img/*
!public/img/denis.webp
!public/img/denis@2x.webp
# Официальный значок Google Play: их файл, скриптом не собирается.
!public/img/google-play-badge.png
# Значок RuStore, если его положить сюда из консоли разработчика.
!public/img/rustore-badge.svg
# Спрайты сада собирает tools/build_garden_sprites.py из наборов, которых в
# репозитории нет и не будет (лицензия). prepare-assets.py их не создаёт,
# поэтому на чистой сборке они возьмутся только отсюда.
!public/img/garden/
# Та же история, что с WOFF2 ниже, и она уже случилась: маскоты производные от
# frontend/assets, но prepare-assets.py в выкатке не запускается. Выкатка идёт
# из чистого worktree и заменяет каталог сайта целиком — и все картинки
# маскотов на бою отдавали 404, пока рабочая папка выглядела исправной.
!public/img/*.webp
# Значки источников кладёт fetch-source-icons.py из чужих доменов; на чистой
# сборке скачивать их заново незачем.
!public/img/sources/
# Эти двое нигде не собираются: они и есть исходники.
!public/img/marja-spilberic.png
!public/img/citavuk_zadumch.png
# Эти четыре WOFF2 нужны уже чистой CI/deploy-сборке. Они производные от TTF,
# но без них локальная рабочая папка выглядела исправной, а prod отдавал 404.
public/fonts/*
!public/fonts/Lora-Regular.woff2
!public/fonts/Lora-Bold.woff2
!public/fonts/NotoSans-Regular.woff2
!public/fonts/NotoSans-Bold.woff2
# Копируется из node_modules скриптом scripts/copy-pdf-worker.mjs.
public/pdf.worker.js
public/course/
public/travel/
# Таблица ударений: собирается scripts/build-stress-marks.py из лексикона
# сервера, полмегабайта производных данных в репозитории не нужны.
public/reader/
