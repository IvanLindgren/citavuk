<?xml version="1.0" encoding="utf-8"?>
<!-- Обновление раз в полчаса — это запас: набор меняется раз в сутки, а всё
     остальное виджет перерисовывает по команде приложения, когда слово
     добавлено или карточка повторена. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:minResizeWidth="180dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_daily"
    android:description="@string/widget_daily_description"
    android:previewLayout="@layout/widget_daily"
    android:widgetCategory="home_screen" />
