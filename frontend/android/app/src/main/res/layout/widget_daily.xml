<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «На каждый день»: слова дня, что повторено и что пора вспомнить.

     Разметка статичная: RemoteViews не умеет создавать строки на ходу, поэтому
     шесть строк слов описаны явно, а лишние провайдер прячет. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp"
    android:id="@+id/widget_root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/widget_daily_title" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/widget_daily_title"
            android:textAllCaps="true"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="@color/widget_accent" />

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/widget_ink" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/widget_ink" />

    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progressDrawable="@drawable/widget_progress" />

    <TextView
        android:id="@+id/widget_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:textColor="@color/widget_ink_soft" />

    <LinearLayout
        android:id="@+id/widget_words"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widget_word_row_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">
            <ImageView
                android:id="@+id/widget_word_dot_0"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:src="@drawable/widget_word_dot"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_word_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13sp"
                android:textColor="@color/widget_ink" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_word_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">
            <ImageView
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:src="@drawable/widget_word_dot"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_word_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13sp"
                android:textColor="@color/widget_ink" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_word_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">
            <ImageView
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:src="@drawable/widget_word_dot"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_word_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13sp"
                android:textColor="@color/widget_ink" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_word_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">
            <ImageView
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:src="@drawable/widget_word_dot"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_word_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13sp"
                android:textColor="@color/widget_ink" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_word_row_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">
            <ImageView
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:src="@drawable/widget_word_dot"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_word_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13sp"
                android:textColor="@color/widget_ink" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_word_row_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">
            <ImageView
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:src="@drawable/widget_word_dot"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_word_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13sp"
                android:textColor="@color/widget_ink" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/widget_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="@color/widget_line" />

    <TextView
        android:id="@+id/widget_faded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="12sp"
        android:textColor="@color/widget_ink_soft" />
</LinearLayout>
