<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «На каждый день»: Читавук, гирлянда, слова дня и что пора
     вспомнить.

     Разметка статичная: RemoteViews не умеет создавать строки на ходу, поэтому
     шесть строк слов описаны явно, а лишние провайдер прячет.

     Ни одна подпись не может налезть на соседнюю: в каждой строке ровно один
     тянущийся элемент (layout_weight), остальные меряются по содержимому, а
     длинный текст обрезается многоточием. Слово и перевод — разные TextView:
     сербское слово должно читаться первым, а не теряться в сплошной строке.

     Огонёк серии и звёздочки — нарисованные картинки, а не символы шрифта:
     emoji на разных прошивках выглядят по-разному, а часть и вовсе рисуется
     пустым квадратом. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp"
    android:id="@+id/widget_root">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:background="@drawable/widget_garland_tile"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:src="@drawable/citavuk_widget"
            android:contentDescription="@string/widget_daily_title" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_daily_header"
                    android:textAllCaps="true"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/widget_accent" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/widget_chip"
                    android:paddingStart="8dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/widget_stove"
                        android:contentDescription="@null" />
                    <TextView
                        android:id="@+id/widget_streak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:maxLines="1"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_ink" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/widget_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/widget_ink" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="9dp"
        android:max="100"
        android:progressDrawable="@drawable/widget_progress" />

    <TextView
        android:id="@+id/widget_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="12sp"
        android:textColor="@color/widget_ink_soft" />

    <LinearLayout
        android:id="@+id/widget_words"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widget_word_row_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">
            <ImageView
                android:id="@+id/widget_word_dot_0"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_word_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/widget_ink" />
            <TextView
                android:id="@+id/widget_word_tr_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.15"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13.5sp"
                android:textColor="@color/widget_ink_soft" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_word_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">
            <ImageView
                android:id="@+id/widget_word_dot_1"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_word_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/widget_ink" />
            <TextView
                android:id="@+id/widget_word_tr_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.15"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13.5sp"
                android:textColor="@color/widget_ink_soft" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_word_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">
            <ImageView
                android:id="@+id/widget_word_dot_2"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_word_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/widget_ink" />
            <TextView
                android:id="@+id/widget_word_tr_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.15"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13.5sp"
                android:textColor="@color/widget_ink_soft" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_word_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">
            <ImageView
                android:id="@+id/widget_word_dot_3"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_word_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/widget_ink" />
            <TextView
                android:id="@+id/widget_word_tr_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.15"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13.5sp"
                android:textColor="@color/widget_ink_soft" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_word_row_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">
            <ImageView
                android:id="@+id/widget_word_dot_4"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_word_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/widget_ink" />
            <TextView
                android:id="@+id/widget_word_tr_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.15"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13.5sp"
                android:textColor="@color/widget_ink_soft" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_word_row_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">
            <ImageView
                android:id="@+id/widget_word_dot_5"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_word_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/widget_ink" />
            <TextView
                android:id="@+id/widget_word_tr_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.15"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13.5sp"
                android:textColor="@color/widget_ink_soft" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/widget_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:background="@color/widget_line" />

    <TextView
        android:id="@+id/widget_faded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="12sp"
        android:textColor="@color/widget_ink_soft" />
</LinearLayout>
