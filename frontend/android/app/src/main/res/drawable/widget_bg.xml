<?xml version="1.0" encoding="utf-8"?>
<!-- Подложка виджета: тёплый пергамент с золотой каймой, как у карточек в
     приложении. Кайма заметная: виджет лежит поверх чужих обоев, и без неё
     край карточки на светлой картинке пропадал. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/widget_bg_top"
        android:endColor="@color/widget_bg_bottom" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1.5dp"
        android:color="@color/widget_gold" />
</shape>
