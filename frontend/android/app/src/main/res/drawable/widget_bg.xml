<?xml version="1.0" encoding="utf-8"?>
<!-- Подложка виджета: тёплый пергамент с золотой каймой, как у карточек в
     приложении. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/widget_bg_top"
        android:endColor="@color/widget_bg_bottom" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_line" />
</shape>
