[Unit]
Description=Citavuk speech transcription
After=network-online.target
Wants=network-online.target

[Service]
User=citavuk
Group=citavuk
WorkingDirectory=/opt/citavuk/audio
EnvironmentFile=/opt/citavuk/.env
EnvironmentFile=-/opt/citavuk/audio/provider.env
ExecStart=/opt/citavuk/audio/.venv/bin/uvicorn transcription_app:app --host 127.0.0.1 --port 8092 --env-file /opt/citavuk/.env --no-access-log
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
