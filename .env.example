# Шаблон настроек Citavuk. Скопируй в .env и подставь значения.
#
# Настоящий .env закрыт от git и не должен попадать ни в репозиторий, ни в
# сборку приложения: ключ переводчика, извлечённый из APK, потратит чужую квоту,
# а пароль от базы даст доступ к данным всех пользователей.

# --- Перевод ---
# Ключ DeepL. Суффикс ":fx" означает free-план: у него отдельный хост API,
# сервер определяет это сам по ключу.
DEEPL_API_KEY=""

# --- База данных ---
# PostgreSQL. Обязательный параметр: без базы сервер не стартует.
DB_URL="postgres://пользователь:пароль@хост:порт/база?sslmode=require"

# --- Redis / Valkey (необязательно) ---
# Общий TTL-кеш и распределённый rate limit. Поддерживаются redis:// и rediss://.
# При ошибке подключения сервер продолжает работать через PostgreSQL и память.
REDIS_URL=""
# CITAVUK_REDIS_PREFIX="citavuk"
# CITAVUK_REDIS_CACHE_TTL="24h"

# --- Вход через Google ---
# Серверу нужны только client_id: он проверяет ID token, а обмен кода на токен
# выполняет само приложение. Client secret на сервере не используется.
GOOGLE_CLIENT_ID_DESKTOP=""
GOOGLE_CLIENT_ID_WEB=""
# React-сборка сама читает GOOGLE_CLIENT_ID_WEB из корневого .env.
# При необходимости его можно переопределить отдельной переменной:
# VITE_GOOGLE_CLIENT_ID=""
# Для Android нужен отдельный client_id с отпечатком SHA-1 ключа подписи.
GOOGLE_CLIENT_ID_ANDROID=""

# --- Вход через Яндекс ---
# Секрет используется только Go-сервером. Redirect URI должен в точности
# совпадать с адресом, зарегистрированным в OAuth-приложении Яндекса.
YANDEX_CLIENT_ID=""
YANDEX_CLIENT_SECRET=""
# YANDEX_REDIRECT_URI="https://api.citavuk.ru/v1/auth/yandex/callback"

# --- Почта подтверждения аккаунта (Resend) ---
RESEND_API_KEY=""
# CITAVUK_EMAIL_FROM="Читавук <noreply@citavuk.ru>"
# CITAVUK_WEB_URL="https://citavuk.ru"
# CITAVUK_EMAIL_VERIFICATION_TTL="24h"

# --- Сервер (необязательное; значения по умолчанию в internal/config) ---
# CITAVUK_ADDR="127.0.0.1:8090"
# CITAVUK_ALLOWED_ORIGINS="https://citavuk.ru,https://www.citavuk.ru"
# CITAVUK_UPSTREAM="https://ivanessalingren-citavukspace.hf.space"
# CITAVUK_SESSION_TTL_DAYS="90"
# Аккаунты с доступом к /admin. Роль выдаётся существующему пользователю при
# старте API; несколько адресов разделяются запятыми.
# CITAVUK_ADMIN_EMAILS="owner@example.com"
# Включать только когда перед сервером действительно стоит nginx: иначе клиент
# подделает X-Forwarded-For и обойдёт ограничение частоты запросов.
# CITAVUK_TRUST_PROXY="false"
